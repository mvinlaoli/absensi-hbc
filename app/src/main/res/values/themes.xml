<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.AbsensiHBC" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/hbc_navy</item>
        <item name="colorPrimaryDark">@color/hbc_navy_dark</item>
        <item name="colorAccent">@color/hbc_gold</item>
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="android:textColorPrimary">@color/dark_text_primary</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>
        <item name="android:statusBarColor">@color/hbc_navy_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Text.AbsensiHBC">
        <item name="android:textColor">@color/dark_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Text.AbsensiHBC.Title">
        <item name="android:textColor">@color/hbc_gold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.AbsensiHBC.Subtitle">
        <item name="android:textColor">@color/dark_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>