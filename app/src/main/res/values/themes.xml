<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- TEMA UTAMA -->
    <style name="Theme.AbsensiHBC" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/hbc_navy</item>
        <item name="colorPrimaryVariant">@color/hbc_navy_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/hbc_gold</item>
        <item name="colorSecondaryVariant">@color/hbc_gold_dark</item>
        <item name="colorOnSecondary">@color/hbc_navy_dark</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        <item name="android:statusBarColor">@color/hbc_navy_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- TEMA DARK -->
    <style name="Theme.AbsensiHBC.Dark" parent="Theme.AbsensiHBC">
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        <item name="android:colorBackground">@color/dark_background</item>
    </style>

    <!-- TEMA LIGHT -->
    <style name="Theme.AbsensiHBC.Light" parent="Theme.AbsensiHBC">
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_text_primary</item>
        <item name="android:colorBackground">@color/light_background</item>
        <item name="android:statusBarColor">@color/hbc_navy</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- STYLE TOMBOL PRIMARY -->
    <style name="Widget.AbsensiHBC.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/hbc_navy_dark</item>
        <item name="backgroundTint">@color/hbc_gold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- STYLE TOMBOL SECONDARY -->
    <style name="Widget.AbsensiHBC.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/hbc_gold</item>
        <item name="strokeColor">@color/hbc_gold</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- STYLE TEXT -->
    <style name="Text.AbsensiHBC">
        <item name="android:textColor">@color/dark_text_primary</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Text.AbsensiHBC.Title">
        <item name="android:textColor">@color/hbc_gold</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.AbsensiHBC.Subtitle">
        <item name="android:textColor">@color/dark_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>