<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dark_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/hbc_navy"
        android:padding="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/hbc_gold"
            android:contentDescription="Kembali" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="Input manual"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tanggal"
                android:textColor="@color/dark_text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnTanggal"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="01 Okt 2026"
                android:textColor="@color/dark_text_primary"
                android:textSize="16sp"
                android:backgroundTint="@color/dark_surface"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pilih anggota"
                android:textColor="@color/dark_text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerAnggota"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/dark_surface"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jenis kegiatan"
                android:textColor="@color/dark_text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerKegiatan"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/dark_surface"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textColor="@color/dark_text_secondary"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerStatus"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@color/dark_surface"
                android:layout_marginBottom="16dp" />

            <LinearLayout
                android:id="@+id/layoutJamCp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jam magang (angka bulat)"
                    android:textColor="@color/dark_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/edtJam"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Contoh: 2"
                    android:textColorHint="@color/dark_text_secondary"
                    android:textColor="@color/dark_text_primary"
                    android:background="@color/dark_surface"
                    android:padding="16dp"
                    android:inputType="number"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CP (boleh desimal)"
                    android:textColor="@color/dark_text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/edtCp"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:hint="Contoh: 0.2"
                    android:textColorHint="@color/dark_text_secondary"
                    android:textColor="@color/dark_text_primary"
                    android:background="@color/dark_surface"
                    android:padding="16dp"
                    android:inputType="numberDecimal"
                    android:layout_marginBottom="16dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/lblStatusManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/dark_text_secondary"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnSimpanManual"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="SIMPAN"
                android:textColor="@color/hbc_navy_dark"
                android:textStyle="bold"
                android:backgroundTint="@color/hbc_gold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>